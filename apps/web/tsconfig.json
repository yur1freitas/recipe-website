{
    "extends": "@config/typescript/react.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "~/*": ["./src/*"]
        },
        "plugins": [{ "name": "next" }]
    },
    "include": [
        ".next/dev/types/**/*.ts",
        ".next/types/**/*.ts",
        "next-env.d.ts",
        "src"
    ],
    "exclude": ["node_modules/**", ".next/**"]
}
