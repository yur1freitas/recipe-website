{
    "name": "@mr/workspace",
    "version": "1.0.0",
    "description": "",
    "license": "MIT",
    "scripts": {
        "fmt": "dprint fmt && oxfmt",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "dev": "turbo run dev",
        "test": "turbo run test",
        "test:core": "turbo run test --filter=@core/*",
        "test:packages": "turbo run test --filter=./packages/**/*",
        "test:coverage": "turbo run test:coverage",
        "build": "turbo run build",
        "build:core": "turbo run build --filter=@core/*",
        "build:packages": "turbo run build --filter=./packages/**/*",
        "typecheck": "turbo run typecheck",
        "taze": "taze -l -I"
    },
    "devDependencies": {
        "@config/typescript": "workspace:",
        "@types/node": "catalog:types",
        "dprint": "catalog:lint",
        "eslint-plugin-perfectionist": "catalog:lint",
        "oxfmt": "catalog:lint",
        "oxlint": "catalog:lint",
        "taze": "catalog:script",
        "tsx": "catalog:script",
        "turbo": "catalog:",
        "typescript": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^10.28.0"
        }
    },
    "engines": {
        "node": "24.12.0"
    },
    "packageManager": "pnpm@10.28.0"
}
