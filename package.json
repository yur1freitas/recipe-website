{
    "name": "@mr/workspace",
    "version": "1.0.0",
    "description": "",
    "license": "MIT",
    "scripts": {
        "fmt": "dprint fmt && oxfmt",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "dev": "turbo run dev",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "test:core": "turbo run test --filter '@core/*'",
        "build": "turbo run build",
        "build:packages": "turbo run build --filter=./packages/**/*",
        "build:core": "turbo run build --filter '@core/*'",
        "typecheck": "turbo run typecheck"
    },
    "devDependencies": {
        "@config/typescript": "workspace:",
        "@types/node": "catalog:",
        "dprint": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "tsx": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^10.28.0"
        }
    },
    "engines": {
        "node": "24.12.0"
    },
    "packageManager": "pnpm@10.28.0"
}
