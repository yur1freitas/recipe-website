{
    "build": { "dockerfile": "Dockerfile", "context": "." },
    "workspaceFolder": "/workspaces/mr-app",
    "forwardPorts": [3000],
    "runArgs": [
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "--network",
        "host"
    ],
    "features": {
        "features": {
            "ghcr.io/devcontainers/features/docker-in-docker:2.16.1": {
                "moby": false
            }
        }
    }
}
