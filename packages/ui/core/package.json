{
    "name": "@ui/core",
    "version": "0.0.1",
    "description": "",
    "license": "MIT",
    "type": "module",
    "exports": {
        "./Box": "./dist/Box.js",
        "./Button": "./dist/Button.js",
        "./Dialog": "./dist/Dialog/index.js",
        "./Icon": "./dist/Icon.js",
        "./Input": "./dist/Input.js",
        "./Label": "./dist/Label.js",
        "./Loading": "./dist/Loading.js",
        "./Menu": "./dist/Menu/index.js",
        "./NumberField": "./dist/NumberField/index.js",
        "./Section": "./dist/Section.js",
        "./Select": "./dist/Select/index.js",
        "./Textarea": "./dist/Textarea.js",
        "./Typography": "./dist/Typography/index.js",
        "./VisuallyHidden": "./dist/VisuallyHidden.js",
        "./package.json": "./package.json",
        ".": {
            "style": "./dist/theme.css"
        }
    },
    "scripts": {
        "build": "pnpm build:tsx && pnpm build:tailwind",
        "build:tsx": "tsdown",
        "build:tailwind": "postcss ./theme.css -o ./dist/theme.css",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "catalog:frontend",
        "@core/time": "workspace:",
        "lucide-react": "catalog:frontend",
        "tailwind-variants": "catalog:frontend"
    },
    "devDependencies": {
        "@config/tsdown": "workspace:",
        "@config/typescript": "workspace:",
        "@rollup/plugin-babel": "catalog:build",
        "@tailwindcss/postcss": "catalog:build",
        "@types/react": "catalog:types",
        "babel-plugin-react-compiler": "catalog:build",
        "postcss-cli": "catalog:script",
        "postcss-nested": "catalog:build",
        "tailwindcss": "catalog:frontend",
        "tsdown": "catalog:build",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "react": "catalog:frontend"
    }
